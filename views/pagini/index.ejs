 <section id="galerie-statica">
    <h2>Galerie</h2>
    <div id="grid-galerie">
    <% 
        let d = new Date();
        let vect_luni = ["ianuarie", "februarie", "martie", "aprilie", "mai", "iunie", "iulie","august","septembrie","octombrie","noiembrie","decembrie"];
        let luna = vect_luni[d.getMonth()]; 
        let litere = ['α', 'β', 'γ', 'δ', 'ε', 'ζ', 'η', 'θ', 'ι', 'κ', 'λ', 'μ', 'ν', 'ξ', 'ο', 'π'];
        let index = 0;
        for(let imag of locals.imagini) {
            if(imag.luni && imag.luni.includes(luna)) {
    %>
        <picture>
            <source srcset="<%- imag.fisier_mediu %>" media="screen and (max-width: 1000px)" />
            <img src="<%= imag.fisier %>" alt="briose">
              <figcaption><%= litere[index % litere.length] %>. <%= imag.descriere %></figcaption>
        </picture>
    <% 
            index++; 
            } 
        } 
    %>
    </div>
</section>

<section id="galerie-animata">
  <h2>Galerie Animată</h2>

  <%
    let imaginiValide = [...locals.imagini];
    let imaginiUnice = [];
    let max = Math.min(12, imaginiValide.length);

    let variante = [12, 10, 8, 6];
    let nr = variante.find(v => v <= max) || max;

    while (imaginiUnice.length < nr && imaginiValide.length > 0) {
      let idx = Math.floor(Math.random() * imaginiValide.length);
      imaginiUnice.push(imaginiValide[idx]);
      imaginiValide.splice(idx, 1);
    }
  %>

  <div class="container-galerie">
    <div class="cadru" style="--nr-imagini:<%= imaginiUnice.length %>;">
      <% for (let i = 0; i < imaginiUnice.length; i++) {
           let imag = imaginiUnice[i]; %>
        <figure class="img-anim-<%= i + 1 %>">
          <img src="<%= imag.fisier %>" alt="<%= imag.descriere %>">
          <figcaption><%= imag.descriere %></figcaption>
        </figure>
      <% } %>
    </div>
  </div>
</section>


    


