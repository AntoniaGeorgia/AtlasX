<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="author" content="AtlasX Travel">
    <meta name="keywords" content="excursii, pachete turistice, călătorii, vacanțe, turism, destinații exotice">
    <meta name="description" content="AtlasX - Descoperă cele mai frumoase destinații și rezervă-ți vacanța de vis cu cele mai bune oferte.">
    <meta name="msapplication-TileColor" content="purple">
        <%- include("../fragmente/head") %>     
        <link href="/resurse/css/produs.css" type="text/css" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    </head>
    <body data-id="<%= prod.id %>">
        <header class="viewport-header">
    <h1>Bine ai venit pe AtlasX!</h1>
    <p>Descoperă cele mai frumoase destinații din lume și planifică-ți vacanța perfectă.</p> </header> 
           
        </header> 
    <main>
        <section>
            <h2>Pagină produs</h2>
                <article id="art-produs">
                    <h3><span class="nume"><%- locals.prod.nume %></span></h3>
                    <p>Pret: <span class="pret"><%- locals.prod.pret %> </span></p>
                    <p>Descriere: <span class="descriere"><%- locals.prod.descriere %> </span></p>
                    <p>Destinatii: <span class="destinatii"><%- locals.prod.destinatii %> </span></p>
                    <p>Durata: <span class="durata_zile"><%- locals.prod.durata_zile %> </span></p>
                    <p>Anotimp: <span class="anotimp"><%- locals.prod.anotimp %> </span></p>
                    <p>Categorie: <span class="categorie"><%- locals.prod.categorie %> </span></p>
                    <p>Pentru familii: <span class="pt_familii"><%- locals.prod.pentru_familii %> </span></p>
                    <p>Data adăugare: <%= new Date(prod.data_adaugare).toLocaleDateString("ro-RO", { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                    <div id="carouselProdus" class="carousel slide mx-auto" data-bs-ride="carousel" style="max-width: 700px;">
  <div class="carousel-inner" id="carousel-inner">
    <div class="carousel-item active">
      <img src="/resurse/imagini/produse/<%= prod.imagine %>" class="d-block w-100 rounded" alt="Imagine principală">
    </div>
    <!-- celelalte imagini vin din JS -->
  </div>

  <button class="carousel-control-prev" type="button" data-bs-target="#carouselProdus" data-bs-slide="prev">
    <span class="carousel-control-prev-icon bg-dark rounded"></span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselProdus" data-bs-slide="next">
    <span class="carousel-control-next-icon bg-dark rounded"></span>
  </button>
</div>
   
                </article>
            
        </section>

    </main>
<script src="/resurse/js/produs.js" defer></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>



    <video id="bg-video" autoplay muted loop playsinline>
    <source src="resurse/video/aquarium.mp4" type="video/mp4">
  </video>
    <%- include("../fragmente/footer") %>
    </body>
</html>